{
  "name": "solar-tank-monitoring-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 -p 3000",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "simulate:device": "node scripts/simulate-device.mjs",
    "pilot:hash-key": "node scripts/generate-device-key.mjs",
    "pilot:registry": "node scripts/apply-pilot-registry.mjs",
    "pilot:smoke": "node scripts/smoke-pilot-ingest.mjs",
    "db:migrate:mysql": "node scripts/apply-mysql-schema.mjs database/migrations/001_create_monitoring_core_mysql.sql",
    "db:migrate:auth": "node scripts/apply-mysql-schema.mjs database/migrations/002_create_auth_core_mysql.sql",
    "db:migrate:auth-recovery": "node scripts/apply-mysql-schema.mjs database/migrations/003_extend_auth_recovery_mysql.sql",
    "db:migrate:device-provisioning": "node scripts/apply-mysql-schema.mjs database/migrations/004_create_device_firmware_provisioning_mysql.sql",
    "db:migrate:device-request-fields": "node scripts/apply-mysql-schema.mjs database/migrations/005_extend_device_request_operational_fields_mysql.sql",
    "db:migrate:helpdesk": "node scripts/apply-mysql-schema.mjs database/migrations/006_create_helpdesk_mysql.sql",
    "db:migrate:reading-rollup": "node scripts/apply-mysql-schema.mjs database/migrations/007_create_reading_rollup_mysql.sql",
    "db:migrate:auth-telegram": "node scripts/apply-mysql-schema.mjs database/migrations/008_enforce_unique_telegram_binding_mysql.sql",
    "db:migrate:site-taxonomy": "node scripts/apply-mysql-schema.mjs database/migrations/009_extend_site_location_taxonomy_mysql.sql",
    "db:migrate:ops-alerting": "node scripts/apply-mysql-schema.mjs database/migrations/010_create_ops_alerting_mysql.sql",
    "db:migrate:device-key-rotation": "node scripts/apply-mysql-schema.mjs database/migrations/011_extend_device_key_rotation_mysql.sql",
    "db:migrate:site-access": "node scripts/apply-mysql-schema.mjs database/migrations/012_create_site_access_scopes_mysql.sql",
    "db:migrate:profile-names": "node scripts/apply-mysql-schema.mjs database/migrations/013_translate_hardware_profile_names_mysql.sql",
    "db:seed:mysql": "node scripts/apply-mysql-schema.mjs database/seeds/001_seed_demo_monitoring_reference_mysql.sql",
    "db:setup:mysql": "pnpm db:migrate:mysql && pnpm db:migrate:auth && pnpm db:migrate:auth-recovery && pnpm db:migrate:device-provisioning && pnpm db:migrate:device-request-fields && pnpm db:migrate:helpdesk && pnpm db:migrate:reading-rollup && pnpm db:migrate:auth-telegram && pnpm db:migrate:site-taxonomy && pnpm db:migrate:ops-alerting && pnpm db:migrate:device-key-rotation && pnpm db:migrate:site-access && pnpm db:migrate:profile-names && pnpm db:seed:mysql",
    "db:backup:mysql": "node scripts/backup-mysql.mjs",
    "db:restore:mysql": "node scripts/restore-mysql.mjs",
    "db:verify:backup": "node scripts/verify-backup.mjs",
    "db:restore:drill": "node scripts/restore-drill.mjs",
    "db:migrations:check": "node scripts/check-mysql-migrations.mjs",
    "audit:sample-data": "node scripts/audit-sample-data.mjs",
    "auth:create-admin": "node scripts/create-auth-admin.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "lucide-react": "^1.21.0",
    "mysql2": "^3.22.5",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@next/env": "^16.2.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
