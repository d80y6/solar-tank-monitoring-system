# =============================================================================
# FTM (Fuel Tank Management) environment reference
#
# Copy this file to .env.local for local development and to the deployment
# environment for production. Never commit real values: .env* is ignored except
# this example file.
# =============================================================================

NEXT_PUBLIC_APP_NAME="FTM - Fuel Tank Management"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_MONITORING_REFRESH_INTERVAL_MS="20000"

# Storage driver:
# - "memory" = development only, data is lost when the server restarts
# - "mysql"  = readings and the registry are stored in MySQL (pilot/production)
SOLAR_TANK_STORAGE_DRIVER="memory"

# Local global key used as a development fallback for POST /api/ingest.
# This value is a development example, not a production secret.
SOLAR_TANK_LOCAL_DEVICE_KEY="local-development-key"

# The global fallback makes early practice easier.
# For the pilot and production set this to "false" and use one key hash per device.
SOLAR_TANK_ALLOW_GLOBAL_DEVICE_KEY_FALLBACK="true"

# Auto provisioning creates a new site/tank/device from a firmware payload.
# It is off by default; enable it only while onboarding new devices.
# In production keep the global fallback off and require a dedicated provisioning key.
SOLAR_TANK_AUTO_PROVISION_DEVICES="false"

# New devices must send the X-Provisioning-Key header with this value while auto
# provisioning is enabled. Devices keep using X-Api-Key as the per-device key
# whose hash is stored.
SOLAR_TANK_DEVICE_PROVISIONING_KEY=""

# Optional simulator key override for a single device.
# When empty the simulator uses the demo key of the dummy device.
# SOLAR_TANK_DEVICE_KEY="demo-tph-key"

# Enable only when SOLAR_TANK_STORAGE_DRIVER="mysql".
# Never put a real password in .env.example.
# MYSQL_DATABASE_URL="mysql://solar_tank_app:password@127.0.0.1:3306/solar_tank_monitoring"

# MySQL connection pool limit.
# For Vercel/serverless start small, for example 1 or 2.
# MYSQL_CONNECTION_LIMIT="2"

# SSL/TLS for cloud MySQL.
# Use "required" when the database provider mandates an encrypted connection.
# Use "disabled" only for local development or a provider without TLS.
# MYSQL_SSL_MODE="required"

# Fill this in only when the provider gives you a CA certificate.
# Multi-line certificates are stored with the literal characters \n.
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# MySQL backups.
# The default output is local-safe: backups/mysql, already ignored by Git.
# For Google Drive, point this folder at a Google Drive Desktop/rclone folder.
# MYSQL_BACKUP_OUTPUT_DIR="backups/mysql"
# MYSQL_BACKUP_RETENTION_DAYS="90"
# Compress the dump before encrypting it (on by default).
# MYSQL_BACKUP_COMPRESS="true"
# Backup encryption key (AES-256-GCM). Required for backups stored anywhere but
# the machine that created them; keep it in the operations password manager, not
# in the repository.
# Without this key the backup is still written as plain text, with a warning.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# MYSQL_BACKUP_ENCRYPTION_KEY=""
# Restore target for pnpm db:restore:mysql. Deliberately separate from
# MYSQL_DATABASE_URL so a drill cannot overwrite operational data.
# MYSQL_BACKUP_RESTORE_URL="mysql://user:password@host:3306/solar_tank_restore_drill"
# Disposable database used to verify a full restore.
# MYSQL_BACKUP_VERIFY_DATABASE_URL=""

# Optional token that lets operational monitoring open /api/ready without a
# browser session. Production can also use an admin session.
# Use a long random token; never a short value and never a real committed token.
# READINESS_CHECK_TOKEN=""

# Dashboard user accounts.
# Never put a real secret in .env.example.
# AUTH_SESSION_COOKIE_NAME="solar_tank_session"
# AUTH_SECRET="replace-with-a-secret-of-at-least-32-characters"
# AUTH_REQUIRE_ADMIN_OTP="true"
# AUTH_ENABLE_REGISTER="true"
# AUTH_ALLOW_PASSWORD_RESET="true"
# AUTH_REQUIRE_EMAIL_VERIFICATION_FOR_APPROVAL="true"
# AUTH_COOKIE_SECURE="false"
# AUTH_PASSWORD_RESET_TTL_SECONDS="1800"
# AUTH_EMAIL_VERIFICATION_TTL_SECONDS="86400"
# AUTH_TELEGRAM_BIND_TTL_SECONDS="600"
# AUTH_SESSION_LAST_SEEN_UPDATE_SECONDS="300"
# APP_BASE_URL is used for verification and password reset links.
# Locally http://localhost:3000 is fine; production must use the real app domain.
# APP_BASE_URL="http://localhost:3000"
# AUTH_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# AUTH_BOOTSTRAP_ADMIN_USERNAME="admin"
# AUTH_BOOTSTRAP_ADMIN_FULL_NAME="Administrator"
# AUTH_BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-password"

# Extra origins allowed to POST to the application (comma separated).
# The application already accepts its own origin; add this only for an
# additional trusted front-end or an internal tool that posts with credentials.
# AUTH_ALLOWED_ORIGINS=""

# Per-location access control (per STO).
# When enabled, non-admin accounts only see the locations assigned on
# /dashboard/admin/access-scopes. Off by default so assignments can be prepared
# before access is restricted.
# AUTH_ENFORCE_SITE_SCOPES="false"

# SMTP for admin OTP e-mail.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# SMTP_FROM="FTM <noreply@example.com>"
# SMTP_SECURE="false"

# Firmware packages issued for device requests.
# DEVICE_PACKAGE_ENCRYPTION_KEY is required in production.
# Create a 32-byte base64 key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# DEVICE_PACKAGE_ENCRYPTION_KEY=""
# DEVICE_PACKAGE_DOWNLOAD_TTL_DAYS="7"
# DEVICE_PACKAGE_MAX_DOWNLOADS="3"

# Transport security baked into generated firmware packages.
# "true"  : device_config.h sets SOLARTANK_ENABLE_REQUEST_SIGNING 1 (HMAC-SHA256)
# "false" : signing disabled, telemetry is sent with the device key only
# SOLARTANK_DEVICE_REQUEST_SIGNING="true"
# PEM text of the CA that issued the server certificate, newlines escaped as \n.
# Leave empty for a local test only: the firmware then logs a warning on boot.
# SOLARTANK_TLS_CA_CERT=""
# Alternative to the CA: SHA-1 fingerprint of the server certificate.
# SOLARTANK_TLS_CERT_FINGERPRINT=""

# CAPTCHA for public forms.
# The only supported providers today are "disabled" and "turnstile".
# Any other value is a misconfiguration and makes readiness fail.
# With "turnstile", set the site key on the client and the secret key on the server.
# AUTH_CAPTCHA_PROVIDER="disabled"
# NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=""
# AUTH_CAPTCHA_SECRET_KEY=""

# Telegram bot for account binding and security notifications.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_BOT_USERNAME="FTMMonitoringBot"
# Optional: send admin notifications to a Telegram group forum/topic.
# When the group/topic is empty the system falls back to the private chat of the
# admins that already bound their account.
# TELEGRAM_ADMIN_GROUP_CHAT_ID=""
# TELEGRAM_TOPIC_NEW_ACCOUNT_THREAD_ID=""
# TELEGRAM_TOPIC_NEW_DEVICE_THREAD_ID=""
# TELEGRAM_TOPIC_LIVE_CHAT_THREAD_ID=""
# TELEGRAM_TOPIC_SYSTEM_THREAD_ID=""

# Pilot registry and smoke test.
# These variables are used by terminal scripts, not by the browser application.
# Never put a real key in .env.example.
# PILOT_REGISTRY_FILE="config/pilot-registry.local.json"
# PILOT_API_BASE_URL="https://solar-tank-monitoring-system.vercel.app"
# PILOT_DEVICE_ID="pilot-tph-01"
# PILOT_DEVICE_KEY="set-in-the-local-env-or-shell"
# PILOT_EXPECT_STORAGE="mysql"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Structured log level: debug, info, warn, error. Defaults to "info" in production.
# LOG_LEVEL="info"
# Log format: "json" (default in production) or "pretty" for manual reading.
# LOG_FORMAT="json"

# Optional error-tracking endpoint (Sentry collector, internal endpoint, ...).
# When empty, errors are still recorded as structured logs and metrics.
# ERROR_TRACKING_WEBHOOK_URL=""
# ERROR_TRACKING_WEBHOOK_TOKEN=""

# Build identity for /api/health, /api/ready, and the build_info metric.
# Vercel fills VERCEL_GIT_COMMIT_SHA automatically; set it manually elsewhere.
# APP_VERSION="0.1.0"
# APP_COMMIT_SHA=""
# APP_BUILD_TIME=""

# Body size limit for POST /api/ingest JSON (bytes, 1024 - 1048576).
# A normal device payload is only a few hundred bytes.
# INGEST_MAX_BODY_BYTES="16384"

# Token that lets a monitoring system scrape GET /api/metrics without an admin login.
# Use a long random token; never commit the real value.
# OPS_METRICS_TOKEN=""

# ---------------------------------------------------------------------------
# Alerting and scheduled operations (/api/cron/ops)
# ---------------------------------------------------------------------------
# Scheduler secret. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# OPS_CRON_SECRET wins, then CRON_SECRET, then READINESS_CHECK_TOKEN.
# When all are empty the endpoint can only be triggered outside production.
# OPS_CRON_SECRET=""
# CRON_SECRET=""

# Disable alert evaluation (on by default) only for scheduled maintenance.
# OPS_ALERTS_ENABLED="true"

# Operational alert thresholds.
# A device is a warning after 2x its reporting interval and critical after 4x.
# A new device that never reported is escalated after this many hours.
# OPS_NEVER_REPORTED_HOURS="24"
# Re-notify an unresolved critical alert after this cooldown.
# OPS_ALERT_RENOTIFY_COOLDOWN_MINUTES="60"
# Escalate a warning to critical after this many minutes.
# OPS_ALERT_ESCALATION_MINUTES="30"
# Resolve an alert automatically after the condition is missing this many evaluations.
# OPS_ALERT_RESOLVE_AFTER_MISSES="3"
# Telemetry rejection spike and firmware package token anomaly thresholds.
# OPS_INGEST_REJECTION_WARNING_COUNT="25"
# OPS_INGEST_REJECTION_WINDOW_MINUTES="60"
# OPS_PACKAGE_TOKEN_ANOMALY_COUNT="5"
# OPS_PACKAGE_TOKEN_WINDOW_MINUTES="60"

# Housekeeping retention (days, except where noted).
# OPS_AUDIT_RETENTION_DAYS="400"
# OPS_INGEST_EVENT_RETENTION_DAYS="120"
# OPS_JOB_RUN_RETENTION_DAYS="60"
# OPS_ALERT_RETENTION_DAYS="400"
# OPS_RATE_LIMIT_RETENTION_HOURS="24"
# Reading retention. 0 = keep forever (default, recommended).
# MONITORING_READING_RETENTION_DAYS="0"

# ---------------------------------------------------------------------------
# Device telemetry security
# ---------------------------------------------------------------------------
# Device request signing (HMAC-SHA256 over "timestamp.nonce.body").
# "off"      : not verified (default, compatible with firmware that cannot sign)
# "optional" : verified when the headers are present
# "required" : X-Request-Timestamp, X-Request-Nonce, and X-Request-Signature are mandatory
# "off" is a bootstrap setting only; production go-live expects "required"
# once every field device runs firmware built with request signing enabled.
# INGEST_SIGNATURE_MODE="off"
# Accepted device clock difference in seconds (30 - 3600).
# INGEST_SIGNATURE_TOLERANCE_SECONDS="300"

# Grace window for the previous device key after a rotation (hours, 1 - 336).
# Field devices keep reporting until the new firmware is flashed.
# DEVICE_KEY_ROTATION_GRACE_HOURS="72"

# Anti-replay nonce retention in monitoring_ingest_nonces (minutes).
# OPS_INGEST_NONCE_RETENTION_MINUTES="120"

# ---------------------------------------------------------------------------
# Client error reporting
# ---------------------------------------------------------------------------
# The limits are enforced in code: 8 KB per report and 30 reports per minute per
# account or IP address.
